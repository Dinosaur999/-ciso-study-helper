(() => {
  "use strict";

  // Prevent duplicate buttons if the script runs again.
  if (document.getElementById("ciso-study-button")) return;

  function addButton() {
    if (!document.body) return;

    const button = document.createElement("button");
    button.id = "ciso-study-button";
    button.type = "button";
    button.textContent = "CISO Study Helper";
    button.setAttribute(
      "aria-label",
      "Open CISO study helper"
    );

    Object.assign(button.style, {
      position: "fixed",
      right: "16px",
      bottom: "20px",
      zIndex: "2147483647",
      padding: "12px 16px",
      border: "0",
      borderRadius: "12px",
      background: "#173b70",
      color: "#ffffff",
      fontSize: "15px",
      fontWeight: "600",
      boxShadow: "0 4px 14px rgba(0,0,0,.25)",
      cursor: "pointer"
    });

    button.addEventListener("click", () => {
      window.alert(
        "CISO Study Helper\n\n" +
        "1. Identify the technical concept.\n" +
        "2. Compare all answer choices.\n" +
        "3. Select the best answer and explain why.\n" +
        "4. Review the exam tip and confidence level.\n\n" +
        "Paste your question into your AI study assistant."
      );
    });

    document.body.appendChild(button);
  }

  if (document.body) {
    addButton();
  } else {
    document.addEventListener("DOMContentLoaded", addButton, {
      once: true
    });
  }